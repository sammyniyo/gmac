APP_NAME="GMAC Coffee"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gmac.coffee

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=u503615494_gmac
DB_USERNAME=u503615494_gmac
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.gmac.coffee

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Hostinger disables symlink(). Store media in public/storage instead of storage:link.
FILESYSTEM_PUBLIC_ROOT=public/storage
MEDIA_DISK=public
MEDIA_UPLOAD_ROOT=uploads

QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=smtp.hostinger.com
MAIL_PORT=465
MAIL_USERNAME=info@gmac.coffee
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@gmac.coffee
MAIL_FROM_NAME="GMAC Coffee"

VITE_APP_NAME="${APP_NAME}"
